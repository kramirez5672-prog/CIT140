    <mxGraphModel dx="1220" dy="801" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#183c43;align=left;" value="Week 5 | Scope and Findings" vertex="1">
          <mxGeometry height="40" width="1070" x="45" y="25" as="geometry" />
        </mxCell>
        <mxCell id="scope" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#edf5f2;strokeColor=#5a7c7d;fontColor=#000000;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;1 · Process scope&lt;br&gt;&lt;/font&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: &amp;quot;.AppleSystemUIFont&amp;quot;;&quot;&gt;&lt;span class=&quot;s1&quot; style=&quot;font-family: &amp;quot;.SFUI-Regular&amp;quot;; vertical-align: 1px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Name: Kristen Ramirez&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: &amp;quot;.AppleSystemUIFont&amp;quot;;&quot;&gt;&lt;span class=&quot;s1&quot; style=&quot;font-family: &amp;quot;.SFUI-Regular&amp;quot;; vertical-align: 1px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Purpose: To show how an appointment moves from scheduling to intake and identify any problems with the process.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: &amp;quot;.AppleSystemUIFont&amp;quot;;&quot;&gt;&lt;span class=&quot;s1&quot; style=&quot;font-family: &amp;quot;.SFUI-Regular&amp;quot;; vertical-align: 1px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Start: A visitor requests an appointment.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: &amp;quot;.AppleSystemUIFont&amp;quot;;&quot;&gt;&lt;span class=&quot;s1&quot; style=&quot;font-family: &amp;quot;.SFUI-Regular&amp;quot;; vertical-align: 1px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;End: The visitor is handed off to the next staff team.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: &amp;quot;.AppleSystemUIFont&amp;quot;;&quot;&gt;&lt;span class=&quot;s1&quot; style=&quot;font-family: &amp;quot;.SFUI-Regular&amp;quot;; vertical-align: 1px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Roles: Visitor, Scheduling, Clinical Operations, Intake, and Next Staff Team.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: &amp;quot;.AppleSystemUIFont&amp;quot;;&quot;&gt;&lt;span class=&quot;s1&quot; style=&quot;font-family: &amp;quot;.SFUI-Regular&amp;quot;; vertical-align: 1px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Outside the scope: The actual medical appointment, treatment, and any new software design.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="155" width="1070" x="45" y="65" as="geometry" />
        </mxCell>
        <mxCell id="walkthrough" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff7ee;strokeColor=#95694b;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;2.&lt;span style=&quot;background-color: transparent;&quot;&gt;Normal appointment: The visitor requests an appointment. Scheduling records the information and checks that the details are complete. Clinical Operations checks room and clinician availability and records readiness. When the visitor arrives, Intake checks the status, confirms support arrangements, and hands the visitor to the next staff team.&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Incident appointment: The booking request was recorded, a slot was held, and a confirmation was sent. However, when the visitor arrived, Intake still showed the appointment as held. Intake then contacted Scheduling and Clinical Operations for clarification.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Gap: W05-S04 shows that no completed readiness decision reached Intake before the visitor arrived. The records do not explain why the decision was missing or prove that it never happened.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="1070" x="45" y="215" as="geometry" />
        </mxCell>
        <mxCell id="sources" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#edf5f2;strokeColor=#5a7c7d;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;3.&lt;span style=&quot;background-color: transparent;&quot;&gt;W05-S01: Supports the scheduling steps, booking details, and clarification process.&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;W05-S02: Supports the clinical readiness check and held appointment process.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;W05-S03: Supports the intake process, status check, and handoff to the next staff team.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;W05-S04: Supports the incident timeline and missing readiness information.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Model review: I checked that each activity was in the correct role&#39;s lane and that the Yes and No decisions showed the correct paths. I also kept the booking confirmation separate from the readiness decision.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Uncertainty: It is unclear why Intake did not receive a completed readiness decision. The readiness record and communication history between Clinical Operations and Intake would help explain what happened.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1070" x="45" y="355" as="geometry" />
        </mxCell>
        <mxCell id="reflection" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff7ee;strokeColor=#95694b;" value="4.This assignment helped me understand how an appointment moves through different departments before the visitor is seen. I learned that receiving a booking confirmation does not necessarily mean the appointment is ready. The records in W05-S04 show that Intake did not have a completed readiness decision, but they do not explain why. This assignment was different from Week 4 because instead of focusing on requirements for a system, I was showing how the current process actually works and where problems can happen." vertex="1">
          <mxGeometry height="140" width="1070" x="45" y="525" as="geometry" />
        </mxCell>
        <mxCell id="evidence" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#edf5f2;strokeColor=#5a7c7d;" value="5.&lt;span style=&quot;background-color: transparent;&quot;&gt;Editable diagram: Ramirez_Kristen_CIT140_Week05_As_Is_Process_Model.drawio&lt;/span&gt;&lt;div&gt;PDF: Ramirez_Kristen_CIT140_Week05_As_Is_Process_Model.pdf&lt;/div&gt;&lt;div&gt;Discord screenshot: Week05_Discord_Post.png&lt;/div&gt;&lt;div&gt;Mission Receipt: Week05_Mission_Receipt.pdf&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;All files will be saved in the Week05 folder of my GitHub repository.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="1070" x="45" y="665" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
